#cloud-config
package_update: true
packages:
  - iptables
write_files:
  - path: /etc/sysctl.d/99-isolated-expansion-nva.conf
    content: |
      net.ipv4.ip_forward=1
      net.ipv4.conf.all.rp_filter=2
      net.ipv4.conf.default.rp_filter=2
  - path: /usr/local/sbin/isolated-expansion-snat.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      sysctl --system
      %{ for cidr in source_prefixes ~}
      iptables -t nat -C POSTROUTING -s ${cidr} ! -d ${cidr} -j MASQUERADE 2>/dev/null || \
        iptables -t nat -A POSTROUTING -s ${cidr} ! -d ${cidr} -j MASQUERADE
      iptables -C FORWARD -s ${cidr} -j ACCEPT 2>/dev/null || \
        iptables -A FORWARD -s ${cidr} -j ACCEPT
      iptables -C FORWARD -d ${cidr} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
        iptables -A FORWARD -d ${cidr} -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
      %{ endfor ~}
      iptables -C FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT 2>/dev/null || \
        iptables -A FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
  - path: /etc/systemd/system/isolated-expansion-snat.service
    content: |
      [Unit]
      Description=Isolated expansion private SNAT
      After=network-online.target
      Wants=network-online.target

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/isolated-expansion-snat.sh
      RemainAfterExit=yes

      [Install]
      WantedBy=multi-user.target
runcmd:
  - systemctl daemon-reload
  - systemctl enable --now isolated-expansion-snat.service
