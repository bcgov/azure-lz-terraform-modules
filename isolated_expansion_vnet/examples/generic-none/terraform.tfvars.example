subscription_id                   = "<subscription-id>"
resource_group_name               = "<resource-group-name>"
routable_vnet_id                  = "/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Network/virtualNetworks/<routable-vnet-name>"
routable_vnet_name                = "<routable-vnet-name>"
routable_vnet_resource_group_name = "<resource-group-name>"
routable_vnet_address_space       = ["10.40.32.0/21"]

# Optional. Off by default. Uncomment to deploy a spoke DNS Private Resolver.
