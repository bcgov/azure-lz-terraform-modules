subscription_id                   = "<subscription-id>"
resource_group_name               = "<resource-group-name>"
routable_vnet_id                  = "/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Network/virtualNetworks/<routable-vnet-name>"
routable_vnet_name                = "<routable-vnet-name>"
routable_vnet_resource_group_name = "<resource-group-name>"
routable_vnet_address_space       = ["10.40.32.0/21"]

# Prefer the central isolated-expansion ruleset from azure_private_dns/private_dns_resolver.
# dns_forwarding_ruleset_id = "/subscriptions/<subscription-id>/resourceGroups/<resource-group-name>/providers/Microsoft.Network/dnsForwardingRulesets/<resolver-name>-isolated-expansion"

# Optional. Off by default. Uncomment only when the platform ruleset is unavailable.
# spoke_dns_resolver = {
#   enabled                 = true
#   inbound_address_prefix  = "10.40.32.0/28"
#   outbound_address_prefix = "10.40.32.16/28"
#   forward_to              = ["<hub-firewall-dns-proxy-ip>"]
# }
