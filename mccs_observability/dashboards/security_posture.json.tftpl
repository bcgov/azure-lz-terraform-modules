{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Microsoft Defender for Cloud secure score and unhealthy security assessments via Azure Resource Graph",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 301,
      "panels": [],
      "title": "Secure Score",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Microsoft Defender for Cloud secure score percentage for the selected subscription",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.5
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 1
      },
      "id": 302,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/securescores' | extend Pct = todouble(properties.score.percentage) | project Pct",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Secure Score",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Number of distinct recommendations with unhealthy resources",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 30
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 1
      },
      "id": 303,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/assessments' | extend State = tostring(properties.status.code), Name = tostring(properties.displayName) | where State == 'Unhealthy' | summarize UnhealthyRecommendations = dcount(Name)",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Unhealthy Recommendations",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Distinct resources failing one or more security assessments",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 10
              },
              {
                "color": "red",
                "value": 50
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 1
      },
      "id": 304,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/assessments' | extend State = tostring(properties.status.code), Resource = tostring(properties.resourceDetails.id) | where State == 'Unhealthy' | summarize UnhealthyResources = dcount(Resource)",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Unhealthy Resources",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Unhealthy assessments rated High or Critical severity",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 20
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 1
      },
      "id": 305,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/assessments' | extend State = tostring(properties.status.code), Severity = tostring(properties.metadata.severity) | where State == 'Unhealthy' and Severity in ('High', 'Critical') | summarize Findings = count()",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "High/Critical Findings",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "id": 306,
      "panels": [],
      "title": "Unhealthy Recommendations",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Recommendations with the most unhealthy resources",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "id": 307,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/assessments' | extend State = tostring(properties.status.code), Name = tostring(properties.displayName), Severity = tostring(properties.metadata.severity) | where State == 'Unhealthy' | summarize UnhealthyResources = count() by Name, Severity | order by UnhealthyResources desc | take 50",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Top Unhealthy Recommendations",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Resources with High or Critical severity findings",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "id": 308,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "securityresources | where type == 'microsoft.security/assessments' | extend State = tostring(properties.status.code), Name = tostring(properties.displayName), Severity = tostring(properties.metadata.severity), Resource = tostring(properties.resourceDetails.id) | where State == 'Unhealthy' and Severity in ('High', 'Critical') | project Name, Severity, Resource | order by Severity, Name | take 100",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "High/Critical Unhealthy Resources",
      "type": "table"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 309,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Data source:** Azure Resource Graph via the Azure Monitor data source (`securityresources` table).\n\n- Requires Microsoft Defender for Cloud to be enabled on the subscription (the free foundational CSPM tier is sufficient for secure score and assessments).\n- Secure score reflects the latest Defender assessment snapshot, not real time.\n- Switch the **Subscription** variable to any subscription the Grafana identity can read.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "About This Dashboard",
      "type": "text"
    }
  ],
