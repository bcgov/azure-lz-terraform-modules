    {
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 41
      },
      "id": 13,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Data source:** subscription activity log routed to the Log Analytics workspace by the `enable_activity_log_diagnostics` diagnostic setting.\n\n- Logs appear in the `AzureActivity` table (can take up to a few minutes to ingest).\n- The **RBAC Changes** panel shows only role assignments in this subscription; management-subscription and Entra role changes require additional diagnostic scopes.\n- To extend coverage to other subscriptions, add the same subscription-level diagnostic setting pointing at this workspace.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "About Platform Changes",
      "type": "text"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "grafana-azure-monitor-datasource",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "${subscription_id}",
          "value": "${subscription_id}"
        },
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${datasource}"
        },
        "definition": "",
        "hide": 0,
        "includeAll": false,
        "label": "Subscription",
        "multi": false,
        "name": "subscription",
        "options": [],
        "query": {
          "queryType": "Azure Subscriptions",
          "refId": "A"
        },
        "refresh": 1,
        "regex": "",
