    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Azure platform service health events for this subscription",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
