      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "AzureActivity | where OperationNameValue contains 'ROLEASSIGNMENTS' | project TimeGenerated, Caller, Operation = OperationNameValue, ResourceGroup, Status = ActivityStatusValue | order by TimeGenerated desc | take 100",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${log_analytics_uid}"
          },
          "queryType": "Azure Log Analytics",
          "refId": "A"
