          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureLogAnalytics": {
            "query": "AzureActivity | where CategoryValue == 'ServiceHealth' | project TimeGenerated, Operation = OperationNameValue, Level, ResourceId | order by TimeGenerated desc | take 50",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "${log_analytics_uid}"
          },
          "queryType": "Azure Log Analytics",
