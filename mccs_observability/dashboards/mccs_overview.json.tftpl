        "overrides": []
      },
      "gridPos": { "h": 4, "w": %{ if enable_aws_cloudwatch ~}3%{ else ~}6%{ endif ~}, "x": %{ if enable_aws_cloudwatch ~}3%{ else ~}6%{ endif ~}, "y": 1 },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
