        {
          "datasource": { "type": "cloudwatch", "uid": "$${cloudwatch}" },
          "dimensions": { "VirtualInterfaceId": "$${dx_vif}" },
          "label": "VIF In",
          "matchExact": false,
          "metricEditorMode": 0,
          "metricName": "VirtualInterfaceBpsIngress",
          "metricQueryType": 0,
          "namespace": "AWS/DX",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Average"
        }
      ],
      "title": "AWS VIF In",
      "type": "stat"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "$${cloudwatch}" },
      "description": "AWS Direct Connect virtual interface outbound bits/sec.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
