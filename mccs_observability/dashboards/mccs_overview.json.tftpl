%{ if enable_aws_cloudwatch ~}
    {
      "datasource": { "type": "cloudwatch", "uid": "$${cloudwatch}" },
      "description": "AWS Direct Connect connection state. 1 = up.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [
            { "options": { "0": { "color": "red", "index": 0, "text": "Down" }, "1": { "color": "green", "index": 1, "text": "Up" } }, "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          },
          "unit": "none"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "id": 60,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "datasource": { "type": "cloudwatch", "uid": "$${cloudwatch}" },
          "dimensions": { "ConnectionId": "$${dx_connection}" },
          "label": "DX",
          "matchExact": true,
          "metricEditorMode": 0,
          "metricName": "ConnectionState",
          "metricQueryType": 0,
          "namespace": "AWS/DX",
          "period": "300",
          "queryMode": "Metrics",
          "refId": "A",
          "region": "default",
          "statistic": "Maximum"
        }
      ],
      "title": "AWS DX",
      "type": "stat"
    },
    {
      "datasource": { "type": "cloudwatch", "uid": "$${cloudwatch}" },
      "description": "AWS Direct Connect virtual interface inbound bits/sec.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "id": 61,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
