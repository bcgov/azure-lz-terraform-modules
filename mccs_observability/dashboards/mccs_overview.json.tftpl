        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }] },
          "unit": "bps"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": %{ if enable_aws_cloudwatch ~}3%{ else ~}6%{ endif ~}, "x": %{ if enable_aws_cloudwatch ~}9%{ else ~}18%{ endif ~}, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
