{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "MCCS connectivity across Azure ExpressRoute and AWS Direct Connect / Site-to-Site VPN",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "mccs"
      ],
      "targetBlank": true,
      "title": "MCCS Dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": [],
      "title": "At a glance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Azure ExpressRoute BGP availability for the selected circuit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "green", "value": 100 }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": %{ if enable_aws_cloudwatch ~}3%{ else ~}6%{ endif ~}, "x": 0, "y": 1 },
      "id": 3,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureMonitor": {
            "aggregation": "Average",
            "dimensionFilters": [],
            "metricName": "BgpAvailability",
            "metricNamespace": "microsoft.network/expressroutecircuits",
            "resourceGroup": "$${resource_group}",
            "resources": [
              {
                "subscription": "$${subscription}",
                "resourceGroup": "$${resource_group}",
                "resourceName": "$${circuit}"
              }
            ],
            "timeGrain": "auto"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Monitor",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Azure BGP",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Azure ExpressRoute ARP availability for the selected circuit.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "mappings": [],
