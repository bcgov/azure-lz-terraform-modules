{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Resource inventory, recently created resources, and policy compliance via Azure Resource Graph",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 201,
      "panels": [],
      "title": "Resource Inventory",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "All resources present in the selected subscription",
      "fieldConfig": {
        "defaults": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                }
              ]
            },
            "unit": 0
          },
          "overrides": []
        },
        "overrides": []
      },
      "gridPos": {
        "h": 4,
        "w": 8,
        "x": 6,
        "y": 0
      },
      "id": 202,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "resources | summarize Resources = count()",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "table",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Total Resources",
      "type": "stat"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Resource counts grouped by resource type",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 6,
        "y": 1
      },
      "id": 203,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "resources | summarize Count = count() by type | order by Count desc | take 50",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Resources by Type",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Resource counts grouped by Azure region",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 9,
        "x": 15,
        "y": 1
      },
      "id": 204,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "resources | summarize Count = count() by location | order by Count desc",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Resources by Location",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Resources created in the last 30 days",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 10,
        "w": 18,
        "x": 6,
        "y": 5
      },
      "id": 205,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "resources | where timeCreated > ago(30d) | project name, type, location, resourceGroup, timeCreated | order by timeCreated desc | take 50",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Recently Created Resources",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 15
      },
      "id": 206,
      "panels": [],
      "title": "Policy Compliance",
      "type": "row"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Policy evaluation states across all resources in the subscription",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 15
      },
      "id": 207,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "policyresources | where type == 'microsoft.policyinsights/policystates' | extend State = tostring(properties.complianceState) | summarize Count = count() by State",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Compliance Summary",
      "type": "table"
    },
    {
      "datasource": {
        "type": "grafana-azure-monitor-datasource",
        "uid": "$${datasource}"
      },
      "description": "Resources failing one or more policy assignments, with the number of failing policies",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": true
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 15
      },
      "id": 208,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "TimeGenerated"
          }
        ]
      },
      "pluginVersion": "11.0.0",
      "targets": [
        {
          "azureResourceGraph": {
            "query": "policyresources | where type == 'microsoft.policyinsights/policystates' | extend State = tostring(properties.complianceState), Resource = tostring(properties.resourceId) | where State == 'NonCompliant' | summarize NonCompliantPolicies = count() by Resource | order by NonCompliantPolicies desc | take 100",
            "resultFormat": "table"
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "$${datasource}"
          },
          "queryType": "Azure Resource Graph",
          "refId": "A",
          "subscription": "$${subscription}"
        }
      ],
      "title": "Non-Compliant Resources",
      "type": "table"
    },
    {
      "datasource": {
        "type": "datasource",
        "uid": "grafana"
      },
      "description": "",
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "id": 209,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
        },
        "content": "**Data source:** Azure Resource Graph via the Azure Monitor data source. The Grafana managed identity uses Monitoring Reader (`*/read`) on the selected subscription.\n\n- Switch the **Subscription** variable to any subscription the identity can read.\n- Policy compliance reflects the latest policy state snapshots ingested by Resource Graph (refreshed continuously, not real-time).\n- `Recently Created` uses `timeCreated` which is populated by Resource Graph for most resource types.",
        "mode": "markdown"
      },
      "pluginVersion": "11.0.0",
      "title": "About This Dashboard",
      "type": "text"
    }
  ],
  "templating": {
    "list": [
      {
        "current": {},
        "hide": 0,
        "includeAll": false,
        "label": "Data Source",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "grafana-azure-monitor-datasource",
        "queryValue": "",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      },
      {
        "current": {
          "selected": true,
          "text": "${subscription_id}",
          "value": "${subscription_id}"
        },
        "datasource": {
          "type": "grafana-azure-monitor-datasource",
          "uid": "$${datasource}"
        },
        "definition": "",
        "hide": 0,
        "includeAll": false,
        "label": "Subscription",
        "multi": false,
        "name": "subscription",
        "options": [],
        "query": {
          "queryType": "Azure Subscriptions",
          "refId": "A"
        },
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "sort": 0,
        "type": "query"
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  },
  "timezone": "browser",
  "title": "Resource Inventory & Policy",
  "uid": "resource-inventory-policy",
  "version": 1,
  "weekStart": ""
}
